{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cine-pomp",
  "main": "src/worker.js",
  "compatibility_date": "2024-11-01",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "cine-pomp-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
      }
    }
  }
}
